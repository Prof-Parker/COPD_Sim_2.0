:: PassageFooter {"position":"500,600","size":"100,100"}
<<nobr>>
/* "recap" passages (e.g. Bedtime) are end-of-day summaries: no observer buttons */
<<if tags().includes("simulation") and State.variables.myRole == "observer" and not tags().includes("recap")>>
    <div id="observer-footer">
        
        <<if tags().includes("activity")>>
        /* --- DYNAMIC PASSAGE ASSESSMENTS (Injected here via <<done>> macros) --- */
		<div style="text-align: center; font-weight: bold; border-top: 1px solid #333; padding-top: 5px;">Activity Specific Observations:	</div>       
		<div id="dynamic-observer-evals"></div>
        <</if>>
        
         /* --- GENERAL CONTROLS --- */
        <div style="text-align: center; font-weight: bold; margin-bottom: 5px; border-top: 1px solid #333; padding-top: 5px;">General Observations:</div>
        
        <div class="eval-grid">
            <!-- Row 1 -->
            <span id="wrap-sat" class="eval-wrap green-wrap">
                <<button '<div class="eval-title">Sat & Rested</div>'>>
                    <<run SimApp.applyGeneralObservation("satAndRested", 2, "wrap-sat")>>
                <</button>>
            </span>
            <span id="wrap-rushed" class="eval-wrap red-wrap">
                <<button '<div class="eval-title">Rushed</div>'>>
                    <<run SimApp.applyGeneralObservation("rushed", -2, "wrap-rushed")>>
                <</button>>
            </span>
            
            <!-- Row 2 -->
            <span id="wrap-pursed" class="eval-wrap green-wrap">
                <<button '<div class="eval-title">Pursed Lip Breathing</div>'>>
                    <<run SimApp.applyGeneralObservation("pursedLip", 1, "wrap-pursed")>>
                <</button>>
            </span>
            <span id="wrap-bent" class="eval-wrap red-wrap">
                <<button '<div class="eval-title">Bent Over</div>'>>
                    <<run SimApp.applyGeneralObservation("bentOver", -1, "wrap-bent")>>
                <</button>>
            </span>
        </div>
        
        <!-- Bottom Row: Inhaler -->
        <div class="footer-control-row inhaler-row">
            <<if $hasInhaler>>
                <span id="wrap-inhaler" class="eval-wrap blue-wrap">
                    <<button '<div class="eval-title">Use Rescue Inhaler</div>'>>
                        <<run SimApp.applyInhalerUse()>>
                    <</button>>
                </span>
            <<else>>
                <div class="gray-box">
                    <div class="eval-title" style="font-style: italic;">Rescue Inhaler</div>
                    <div class="eval-sub" style="font-style: italic;">Left at home</div>
                </div>
            <</if>>
        </div>
    </div>
<<elseif tags().includes("simulation") and State.variables.myRole == "patient">>
    <div id="patient-footer">
        <<if tags().includes("activity")>>
        <div id="patient-footer-choices"></div>
        <</if>>
        <div id="patient-footer-next"></div>
    </div>
<</if>>
<</nobr>>


:: PassageHeader {"position":"500,200","size":"100,100"}
<<nobr>>
<<if tags().includes("simulation")>>
    <<run SimApp.syncFromPlayroom()>>
    <<run State.variables.myRole = window.SimApp ? SimApp.getRole() : State.variables.myRole>>
<</if>>
<<script>>
    /* Restore role CSS class after SugarCube passage transitions */
    var role = window.SimApp && SimApp.getRole();
    if (role) {
        $("body").removeClass("role-patient role-observer").addClass("role-" + role);
    }
<</script>>
<<if tags().includes("simulation") && !tags().includes("hidehud")>>
    <<set $Energy to SimApp.getVal("Energy")>>
    <<set $Inhaler to SimApp.getVal("Inhaler")>>
    <<set $Points to SimApp.getVal("Points")>>
    <<set $hasInhaler to SimApp.getVal("hasInhaler")>>

    <span id="hidden-time" class="hidden"></span>

    <<if $myRole == "observer">>
        <div id="observer-hud" class="hud-bar">
            <span class="hud-stats">
                <span class="hud-item"><strong>Time:</strong>&nbsp;<span class="time-display">00:00</span></span><span class="hud-sep">|</span>
                <span class="hud-item"><strong>Energy:</strong>&nbsp;<span id="energy-display"><<print $Energy>></span> / 15</span><span class="hud-sep">|</span>
                <span class="hud-item"><strong>Inhaler:</strong>&nbsp;<span id="inhaler-display"><<print $Inhaler>></span></span><span class="hud-sep">|</span>
                <span class="hud-item"><strong>Points:</strong>&nbsp;<span id="points-display"><<print $Points>></span></span>
            </span>
            <button type="button" class="hud-invite-btn" aria-label="Show invite QR code so your partner can join or rejoin" onclick="SimApp.showInviteModal()">QR<span class="hud-invite-word"> Invite</span></button>
        </div>
    <<else>>
        <div id="patient-hud" class="hud-bar">
            <span class="hud-stats">
                <span class="hud-item"><strong>Time:</strong>&nbsp;<span class="time-display">00:00</span></span><span class="hud-sep">|</span>
                <span class="hud-item"><strong>Status:</strong>&nbsp;<span id="patient-breathing-status">...</span></span><span class="hud-sep">|</span>
                <span class="hud-item"><strong>Inhaler:</strong>&nbsp;<span id="patient-inhaler-status">...</span></span>
            </span>
            <button type="button" class="hud-invite-btn" aria-label="Show invite QR code so your partner can join or rejoin" onclick="SimApp.showInviteModal()">QR<span class="hud-invite-word"> Invite</span></button>
        </div>
    <</if>>

    <<silently>>
        /* Cloudflare: the room clock lives on the server. Playroom: host broadcasts elapsed time. */
        <<repeat 1s>>
            <<if window.SimApp && SimApp.isCloudNet()>>
                <<run $(".time-display").text(SimApp.formatElapsed())>>
            <<elseif window.SimApp && window.SimApp.isPlayroomLoaded>>
                <<if Net.isHost()>>
                    <<replace '#hidden-time'>><<playtime>><</replace>>
                    <<run Net.setState("sharedTime", $("#hidden-time").text(), true)>>
                    <<run $(".time-display").text($("#hidden-time").text())>>
                <<else>>
                    <<run $(".time-display").text(Net.getState("sharedTime") || "00:00")>>
                <</if>>
            <<else>>
                <<replace '.time-display'>><<playtime>><</replace>>
            <</if>>
        <</repeat>>
    <</silently>>
<</if>>
<</nobr>>


