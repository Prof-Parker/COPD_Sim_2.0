:: Waiting_Room {"position":"1050,600","size":"100,100"}
! Waiting for Partner...
<hr>\
<<if State.variables.myRole == "patient">>
    You are the **Patient**. Please wait for your Observer to be ready.
<<else>>
    You are the **Observer**. Please wait for your Patient to be ready.
<</if>>

<div id="host-invite-slot-wait"></div>

<div id="status-message">Waiting for partner to select their role...</div>

<div id="conflict-container" class="hidden" style="margin-top: 20px; padding: 15px; border: 2px solid #dc3545; border-radius: 8px; background-color: #f8d7da; color: #721c24;">
    <strong>Role Conflict!</strong><br>
    Both players have selected the same role. One of you needs to switch.
    <<button "Switch My Role">>
        <<script>>
            clearInterval(window.waitingInterval);
            if (window.SimApp) {
                Playroom.myPlayer().setState("role", "", true);
                SimApp.clearLobbyRole(SimApp.myRole);
                SimApp.myRole = "";
            }
            State.variables.myRole = "";
            $("body").removeClass("role-patient role-observer");
            Engine.play("Role_Selection");
        <</script>>
    <</button>>
</div>

<<script>>
    if (window.SimApp) {
        SimApp.mountHostInviteButton("host-invite-slot-wait", "Show Invite QR Code");
    }

    /* We attach the interval to the window object so the button script can clear it safely */
    window.waitingInterval = setInterval(function() {
        if (SimApp.checkReadyState()) {
            clearInterval(window.waitingInterval);
            SimApp.goToSharedPassage("Simulation_Hub");
        } else if (SimApp.checkRoleConflict()) {
            $("#status-message").addClass("hidden");
            $("#conflict-container").removeClass("hidden");
        } else {
            $("#status-message").removeClass("hidden");
            $("#conflict-container").addClass("hidden");
        }
    }, 1000);
<</script>>

<!--[[Simulation_Hub]]-->


