:: Widgets [widget] {"position":"500,400","size":"100,100"}
<<nobr>>
/* SMART WIDGET: Energy changes sync to Playroom; triggers shared game over */
<<widget "Adjust_Energy">>
    <<set _amount to _args[0]>>
    <<set _currentEnergy to SimApp.getVal("Energy")>>
    <<set _newEnergy to _currentEnergy + _amount>>

    <<if _newEnergy > 15>><<set _newEnergy to 15>><</if>>
    <<if _newEnergy < 0>><<set _newEnergy to 0>><</if>>

    <<run SimApp.setVal("Energy", _newEnergy)>>
    <<run $("#energy-display").text(_newEnergy)>>

    <<if _newEnergy <= 0 and !tags().includes("briefing")>>
        <<run SimApp.scheduleGameOver("Game_Over_Energy")>>
    <</if>>
<</widget>>

/* SMART WIDGET: Rescue inhaler use + overdose game over */
<<widget "Use_Inhaler">>
    <<set _currentInhaler to SimApp.getVal("Inhaler")>>
    <<set _newInhaler to _currentInhaler + 1>>

    <<run SimApp.setVal("Inhaler", _newInhaler)>>
    <<run $("#inhaler-display").text(_newInhaler)>>

    <<Adjust_Energy 2>>

    <<if _newInhaler >= 7 and !tags().includes("briefing") and !SimApp.isGameOverPending()>>
        <<run SimApp.scheduleGameOver("Game_Over_Inhaler")>>
    <</if>>
<</widget>>

/* OBSERVER WIDGET: General footer evaluation buttons */
<<widget "Observer_Eval">>
    <<set _varName to _args[0]>>
    <<set _energyChange to _args[1]>>
    <<set _btnWrapId to _args[2]>>

    <<Track_Behavior _varName>>
    <<Adjust_Energy _energyChange>>

    <<run $("#" + _btnWrapId + " button").prop("disabled", true)>>
<</widget>>

/* SMART WIDGET: Points adjustments */
<<widget "Adjust_Points">>
    <<set _amount to _args[0]>>
    <<set _currentPoints to SimApp.getVal("Points")>>
    <<set _newPoints to _currentPoints + _amount>>

    <<run SimApp.setVal("Points", _newPoints)>>
    <<run $("#points-display").text(_newPoints)>>
<</widget>>

/* SMART WIDGET: Behavioral tracking for debriefing */
<<widget "Track_Behavior">>
    <<for _i to 0; _i < _args.length; _i++>>
        <<set _behaviorName to _args[_i]>>
        <<set _currentVal to SimApp.getVal(_behaviorName) || 0>>
        <<run SimApp.setVal(_behaviorName, _currentVal + 1)>>
    <</for>>
<</widget>>

/* LEGACY: Prefer <<dynamic-eval>> macro in passages (see StoryScript). */
<<widget "Dynamic_Eval_Button">>
    <<set _title to _args[0]>>
    <<set _sub to _args[1]>>
    <<set _energyChange to _args[2]>>
    <<set _pointsChange to _args[3]>>
    <<set _behavior to _args[4]>>
    <<set _wrapClass to "eval-wrap " + _args[5] + "-wrap">>

    <<set _btnText to '<div class="eval-title">' + _title + '</div><div class="eval-sub">' + _sub + '</div>'>>

    <span class="<<print _wrapClass>>">
        <<button _btnText>>
            <<Adjust_Energy _energyChange>>
            <<Adjust_Points _pointsChange>>
            <<if _behavior neq "none" and _behavior neq "">>
                <<Track_Behavior _behavior>>
            <</if>>
            <<run SimApp.setVal("evalComplete", true)>>
            <<replace "#dynamic-eval-container">>
                <div class="gray-box">Assessment Recorded</div>
            <</replace>>
        <</button>>
    </span>
<</widget>>

/* LEGACY: Prefer <<patient-next>> macro (renders in #patient-footer-next). */
<<widget "Patient_Next_Button">>
    <<set _btnText to _args[0]>>
    <<set _targetPassage to _args[1]>>

    <span id="patient-next-container">
        <div class="gray-box">Waiting for Observer Evaluation...</div>
    </span>

    <<silently>>
        <<repeat 500ms>>
            <<if SimApp.getVal("evalComplete") === true>>
                <<replace "#patient-next-container">>
                    <<button _btnText>>
                        <<run SimApp.nextPassage(_targetPassage)>>
                    <</button>>
                <</replace>>
                <<stop>>
            <</if>>
        <</repeat>>
    <</silently>>
<</widget>>
<</nobr>>


